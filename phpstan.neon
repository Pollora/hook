includes:
    # The harness preset includes the WordPress stubs and rules: hook callback signatures, constants that have a function (DOING_CRON → wp_doing_cron())
    - vendor/pollora/harness/presets/phpstan/base.neon

parameters:
    level: 5
    paths:
        - src
        - tests
    excludePaths:
        - vendor/*
    ignoreErrors:
        # Action Scheduler is a plugin: its functions are not part of the WordPress stubs
        - '#Function as_[a-z_]+ not found#'
        # Pest.php dynamic properties
        - '#Access to an undefined property PHPUnit\\Framework\\TestCase::\$[a-zA-Z0-9_]+.#'
    # Only patterns still needed are listed: report one that no longer matches, so it is removed
    reportUnmatchedIgnoredErrors: true
